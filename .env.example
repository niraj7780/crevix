# ==============================================================================
# CREVIX ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env.local for local development.
# Do NOT commit .env or .env.local to version control.
# Crevix operates with zero-cost fallback/mock modes if external credentials are unset.

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Secret used to encrypt social OAuth tokens and API keys at rest (32-byte hex or string)
ENCRYPTION_SECRET_KEY=e4d2a1b9c8f7e6d5c4b3a291807f6e5d4c3b2a109876543210fedcba98765432

# ------------------------------------------------------------------------------
# 2. AUTHENTICATION (CLERK)
# ------------------------------------------------------------------------------
# Sign up at https://clerk.com for free development tier
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_sample_key
CLERK_SECRET_KEY=sk_test_sample_key
CLERK_WEBHOOK_SECRET=whsec_sample_key
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/signup
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# ------------------------------------------------------------------------------
# 3. DATABASE (NEON POSTGRESQL)
# ------------------------------------------------------------------------------
# Sign up at https://neon.tech for free tier PostgreSQL
DATABASE_URL=postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/omniflow?sslmode=require

# ------------------------------------------------------------------------------
# 4. CLOUDFLARE R2 OBJECT STORAGE (Zero Egress Media Assets)
# ------------------------------------------------------------------------------
# Create an S3 API token in Cloudflare Dashboard -> R2
R2_ACCOUNT_ID=sample_cf_account_id
R2_ACCESS_KEY_ID=sample_r2_access_key
R2_SECRET_ACCESS_KEY=sample_r2_secret_key
R2_BUCKET_NAME=omniflow-media-dev
R2_PUBLIC_URL=https://media.omniflow.io

# ------------------------------------------------------------------------------
# 5. CLOUDFLARE WORKERS & QUEUES (Background Execution)
# ------------------------------------------------------------------------------
CLOUDFLARE_ACCOUNT_ID=sample_cf_account_id
CLOUDFLARE_API_TOKEN=sample_cf_api_token

# ------------------------------------------------------------------------------
# 6. EMAIL DELIVERY (RESEND)
# ------------------------------------------------------------------------------
# Free tier gives 3,000 emails/month at https://resend.com
RESEND_API_KEY=re_sample_key
EMAIL_FROM=Omniflow <notifications@omniflow.io>

# ------------------------------------------------------------------------------
# 7. META GRAPH API (INSTAGRAM INTEGRATION)
# ------------------------------------------------------------------------------
# Configure app at https://developers.facebook.com
META_APP_ID=sample_meta_app_id
META_APP_SECRET=sample_meta_app_secret
META_WEBHOOK_VERIFY_TOKEN=omniflow_meta_verify_token_sample
META_WEBHOOK_APP_SECRET=sample_meta_webhook_app_secret

# ------------------------------------------------------------------------------
# 8. PAYMENTS & SUBSCRIPTIONS (DODO PAYMENTS)
# ------------------------------------------------------------------------------
DODO_PAYMENTS_API_KEY=dodo_test_sample_key
DODO_WEBHOOK_KEY=wh_sample_dodo_key
DODO_ENVIRONMENT=test_mode

# ------------------------------------------------------------------------------
# 9. AI PROVIDERS (BYOK - Bring Your Own Key Support)
# ------------------------------------------------------------------------------
# Options: openai | gemini | anthropic | mock
AI_PROVIDER=gemini
AI_API_KEY=sample_ai_api_key
